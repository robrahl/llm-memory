{
  "name": "llm-memory",
  "version": "0.1.0",
  "description": "Developer AI Agent with Persistent Memory for architecture policies and knowledge base",
  "main": "dist/agent.js",
  "type": "module",
  "scripts": {
    "dev": "tsx src/agent.ts",
    "dev:ui": "vite",
    "build": "tsc",
    "build:ui": "vite build",
    "build:all": "npm run build && npm run build:ui",
    "build:mcp": "tsc src/mcp-server.ts --outDir dist --declaration",
    "dev:mcp": "tsx src/mcp-server.ts",
    "test": "jest",
    "lint": "eslint src/",
    "format": "prettier --write src/",
    "start": "node dist/agent.js"
  },
  "keywords": [
    "llm",
    "agent",
    "architecture",
    "policies",
    "knowledge-base",
    "embeddings",
    "pgvector"
  ],
  "author": "RobRah",
  "license": "MIT",
  "dependencies": {
    "axios": "^1.6.5",
    "bootstrap": "^5.3.8",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "pg": "^8.11.3",
    "pg-promise": "^11.5.4",
    "pinia": "^3.0.4",
    "uuid": "^9.0.1",
    "winston": "^3.11.0"
  },
  "devDependencies": {
    "@cfworker/json-schema": "^4.1.1",
    "@tailwindcss/postcss": "^4.1.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.11",
    "@types/node": "^20.19.25",
    "@types/pg": "^8.15.6",
    "@typescript-eslint/eslint-plugin": "^6.17.0",
    "@typescript-eslint/parser": "^6.17.0",
    "@vitejs/plugin-vue": "^6.0.1",
    "autoprefixer": "^10.4.22",
    "daisyui": "^5.5.5",
    "eslint": "^8.56.0",
    "jest": "^29.7.0",
    "postcss": "^8.5.6",
    "prettier": "^3.1.1",
    "tailwindcss": "^4.1.17",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.2",
    "tsx": "^4.7.0",
    "typescript": "^5.9.3",
    "vite": "^7.2.2",
    "vue": "^3.5.24"
  },
  "optionalDependencies": {
    "@modelcontextprotocol/sdk": "^1.22.0",
    "zod": "^3.25.76"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/yourusername/llm-memory.git"
  }
}
