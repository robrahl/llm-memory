{
  "name": "llm-memory",
  "version": "0.1.0",
  "description": "Developer AI Agent with Persistent Memory for architecture policies and knowledge base",
  "main": "dist/agent.js",
  "type": "module",
  "scripts": {
    "dev": "tsx src/agent.ts",
    "build": "tsc",
    "build:mcp": "tsc src/mcp-server.ts --outDir dist --declaration",
    "dev:mcp": "tsx src/mcp-server.ts",
    "test": "jest",
    "lint": "eslint src/",
    "format": "prettier --write src/",
    "start": "node dist/agent.js"
  },
  "keywords": [
    "llm",
    "agent",
    "architecture",
    "policies",
    "knowledge-base",
    "embeddings",
    "pgvector"
  ],
  "author": "RobRah",
  "license": "MIT",
  "dependencies": {
    "express": "^4.18.2",
    "pg": "^8.11.3",
    "pg-promise": "^11.5.4",
    "axios": "^1.6.5",
    "dotenv": "^16.3.1",
    "winston": "^3.11.0",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "@types/node": "^20.10.6",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.11",
    "typescript": "^5.3.3",
    "ts-node": "^10.9.2",
    "tsx": "^4.7.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.1",
    "eslint": "^8.56.0",
    "@typescript-eslint/eslint-plugin": "^6.17.0",
    "@typescript-eslint/parser": "^6.17.0",
    "prettier": "^3.1.1"
  },
  "optionalDependencies": {
    "@modelcontextprotocol/sdk": "^0.1.0",
    "zod": "^3.22.4"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/yourusername/llm-memory.git"
  }
}
