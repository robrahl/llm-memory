FROM node:20-alpine

WORKDIR /app

# Copy package files
COPY package.json ./

# Install dependencies (includes dev deps for dev run)
RUN npm install --no-audit --no-fund

# Copy source and config
COPY src ./src
COPY ui ./ui
COPY tsconfig.json ./
COPY vite.config.ts ./
COPY tailwind.config.ts ./
COPY healthcheck.js ./

# Build TypeScript and UI
RUN npm run build:all || true

# Expose port
EXPOSE 3000

# Default command is overridden in docker-compose for dev
CMD ["npm", "run", "start"]
