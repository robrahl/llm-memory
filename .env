# Development Environment Variables for Windows Docker Desktop

# Database
DB_USER=postgres
DB_PASSWORD=dev_password_123

# Database
POSTGRES_DB=ai_memory

# Node
NODE_ENV=development
LOG_LEVEL=debug

# LLM Provider (LM Studio by default; also supports Ollama)
LLM_PROVIDER=openai
LLM_BASE_URL=http://host.docker.internal:11434
LLM_MODEL=mistral:7b

# Agent
AGENT_HOST=0.0.0.0
AGENT_PORT=3000
API_TIMEOUT_MS=30000
QUERY_CACHE_TTL_DAYS=7

# Optional: Debugging
DEBUG=llm-memory:*
